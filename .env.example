# ==============================================================================
# FLUXLINK: PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================

# Environment mode: 'production' or 'development'
FLUXLINK_ENV=production

# Authoritative Supabase PostgreSQL Database URL
# Transaction mode pooler (port 6543) or direct session connection (port 5432)
# e.g.: postgresql://postgres.<PROJECT_REF>:<ENCODED_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API & Private Storage Configuration
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chennalink-files

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://fluxlink.chennareddy.in,http://localhost:8000,http://127.0.0.1:8000

# Transfer & File Limits
FLUXLINK_MAX_FILE_SIZE_MB=10
CHENNALINK_MAX_FILE_SIZE_MB=10

# Local ASGI Server Binding (Behind Nginx reverse proxy)
API_HOST=127.0.0.1
API_PORT=8000
